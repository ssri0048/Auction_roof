# Copy to .env and adjust:  cp .env.example .env
# .env is git-ignored. Never commit real passwords.

# Local PostgreSQL (docker compose up -d db)
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=auction_roof_development

# Do NOT put DATABASE_URL here: Rails would use it for development AND test,
# and the test run would wipe that database. DATABASE_URL is set on Railway only.

# SMS provider for OTP. "mock" sends nothing (messages kept in memory, logged outside production).
SMS_PROVIDER=mock

# Active Record encryption (national ID, passport, bank account numbers).
# Generate with: bin/rails db:encryption:init   (copy the three values here)
# Every environment that shares a database MUST use the same keys.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
