<%= form_with model: auction, class: "form panel", data: { controller: "auction-type" } do |form| %>
  <% if auction.errors.any? %>
    <div class="flash flash--alert">
      <ul class="error-list"><% auction.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :title, "ชื่อรายการ *" %>
    <%= form.text_field :title, required: true, maxlength: 200 %>
  </div>
  <div class="field">
    <%= form.label :description, "รายละเอียด" %>
    <%= form.text_area :description, rows: 5 %>
  </div>
  <fieldset class="type-pick" <%= "disabled" if auction.bids_count.positive? %>>
    <legend>วิธีประมูล *</legend>
    <% Auction::TYPES.each_key do |type| %>
      <label class="type-pick__opt">
        <%= form.radio_button :auction_type, type, data: { action: "auction-type#change" } %>
        <span>
          <strong><%= AuctionsHelper::TYPE_SHORT[type] %></strong>
          <small><%= AuctionsHelper::TYPE_HELP[type] %></small>
        </span>
      </label>
    <% end %>
  </fieldset>

  <div class="grid">
    <div class="field">
      <label for="auction_starting_price" data-auction-type-target="priceLabel"><%= starting_price_label(auction) %> (บาท) *</label>
      <%= form.number_field :starting_price, min: 1, step: "any", required: true, inputmode: "decimal", disabled: auction.bids_count.positive? %>
    </div>
    <div class="field" data-auction-type-target="increment" <%= "hidden" if auction.sealed? %>>
      <%= form.label :min_increment, "ขั้นต่ำการเพิ่ม/ลดราคาต่อครั้ง (บาท) *" %>
      <%= form.number_field :min_increment, min: 1, step: "any", inputmode: "decimal", required: !auction.sealed?, disabled: auction.sealed? %>
    </div>
    <div class="field">
      <%= form.label :starts_at, "เวลาเริ่ม *" %>
      <%= form.datetime_local_field :starts_at, required: true %>
    </div>
    <div class="field">
      <%= form.label :ends_at, "เวลาปิด *" %>
      <%= form.datetime_local_field :ends_at, required: true %>
    </div>
  </div>

  <div class="field upload">
    <%= form.label :photos, "รูปภาพ (JPG/PNG/WEBP สูงสุด #{Auction::MAX_PHOTOS} รูป, 10MB ต่อรูป)" %>
    <%= form.file_field :photos, multiple: true, accept: Auction::PHOTO_TYPES.join(",") %>
  </div>

  <% if auction.persisted? && auction.photos.attached? %>
    <fieldset class="photo-pick">
      <legend>เลือกรูปที่ต้องการลบ</legend>
      <% auction.photos.each do |photo| %>
        <label>
          <%= check_box_tag "remove_photo_ids[]", photo.id, false, id: "remove_photo_#{photo.id}" %>
          <%= image_tag rails_blob_path(photo, disposition: "inline"), alt: "" %>
        </label>
      <% end %>
    </fieldset>
  <% end %>

  <div class="form-actions">
    <%= link_to "ยกเลิก", auction.persisted? ? auction_path(auction) : auctions_path(tab: "mine"), class: "btn btn-ghost" %>
    <% if auction.published? && !can?(:manage_auctions) %>
      <small class="muted form-note">บันทึกการแก้ไขแล้ว รายการจะต้องรอแอดมินอนุมัติใหม่</small>
    <% end %>
    <% if auction.new_record? || auction.draft? %>
      <%= form.submit "บันทึกร่าง", class: "btn btn-ghost" %>
      <%= form.submit (can?(:manage_auctions) ? "เปิดประมูล" : "ส่งให้แอดมินอนุมัติ"), name: "publish", class: "btn" %>
    <% else %>
      <%= form.submit "บันทึก", class: "btn" %>
    <% end %>
  </div>
<% end %>
