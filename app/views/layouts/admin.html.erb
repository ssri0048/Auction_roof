<% content_for :full_page, true %>
<% content_for :title, "#{content_for(:admin_title)} | ระบบจัดการ Auction Roof" if content_for?(:admin_title) %>
<% content_for :body_html do %>
<div class="admin">
  <aside class="admin-side">
    <a href="<%= root_path %>" class="brand admin-brand"><span class="brand-mark">AR</span> Auction Roof</a>
    <nav class="admin-nav" aria-label="เมนูผู้ดูแลระบบ">
      <% if can?(:manage_users) %>
        <%= link_to "ผู้ใช้งาน", admin_users_path, class: ("is-active" if controller_name == "users") %>
      <% end %>
      <% if can?(:manage_users) %>
        <%= link_to admin_onboardings_path, class: ("is-active" if controller_name == "onboardings") do %>
          ตรวจสอบผู้ประมูล
          <% if (waiting = User.onboarding_submitted.count).positive? %><span class="admin-count"><%= waiting %></span><% end %>
        <% end %>
      <% end %>
      <% if can?(:manage_roles) %>
        <%= link_to "บทบาทและสิทธิ์", admin_roles_path, class: ("is-active" if controller_name == "roles") %>
      <% end %>
      <% if can?(:manage_auctions) %>
        <%= link_to admin_auctions_path, class: ("is-active" if controller_name == "auctions") do %>
          รายการประมูล
          <% if (pending = Auction.pending.count).positive? %><span class="nav-count" title="รออนุมัติ"><%= pending %></span><% end %>
        <% end %>
      <% end %>
      <% if can?(:view_reports) %>
        <%= link_to "รายงาน", admin_reports_path, class: ("is-active" if controller_name == "reports") %>
      <% end %>
      <%= link_to "กลับหน้าหลัก", root_path %>
    </nav>
    <%= render "layouts/theme_toggle" %>
    <div class="admin-me">
      <span><%= Current.user.full_name %></span>
      <small><%= Current.user.role&.name || "ไม่มีบทบาท" %></small>
    </div>
  </aside>
  <main class="admin-main">
    <%= render "layouts/flash" %>
    <%= yield %>
  </main>
</div>
<% end %>
<%= render template: "layouts/application" %>
