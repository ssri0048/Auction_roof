<% content_for :title, "#{onboarding_step_label(@step)} | Auction Roof" %>

<div class="card card--wide onboarding">
  <%= render "onboarding/progress" %>
  <h1 class="card__title"><%= onboarding_step_label(@step) %></h1>

  <% if (messages = onboarding_error_messages(@record, *@nested_records)).any? %>
    <div class="flash flash--alert">
      <ul><% messages.each do |message| %><li><%= message %></li><% end %></ul>
    </div>
  <% end %>

  <%= form_with model: @record || false, scope: :onboarding, url: onboarding_step_path(@step), method: :patch, multipart: true, class: "form" do |form| %>
    <%= render "onboarding/steps/#{User::ONBOARDING_STEPS.fetch(@step_index)}", form: form %>

    <div class="onboarding__actions">
      <% if @step_index > 0 %>
        <%= form.button "ย้อนกลับ", name: "back", value: "1", class: "btn btn-ghost", formnovalidate: true %>
      <% end %>
      <% if @step == User::ONBOARDING_STEPS.last %>
        <%= form.button "ยืนยันและส่งข้อมูล", class: "btn" %>
      <% else %>
        <span class="onboarding__next">
          <% if skippable_step? %>
            <%= form.button "ข้าม", name: "skip", value: "1", class: "btn btn-ghost", formnovalidate: true %>
          <% end %>
          <%= form.button "ถัดไป", class: "btn" %>
        </span>
      <% end %>
    </div>
  <% end %>
</div>
